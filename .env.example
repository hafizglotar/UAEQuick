# Public site URL (no trailing slash) - used for canonical URLs, sitemap, schema.
NEXT_PUBLIC_SITE_URL=https://uaequick.com

# Business contact (public, used in CTAs and schema)
NEXT_PUBLIC_PHONE=+971507046234
NEXT_PUBLIC_WHATSAPP=971589331711
# Google Business Profile share link (used in LocalBusiness/Organization sameAs)
NEXT_PUBLIC_GBP_URL=

# --- Lead delivery (server-side, optional) ---
# Where /api/lead forwards submissions. Leave blank to log only.
# A generic webhook (Zapier/Make/n8n/CRM) that accepts JSON:
LEAD_WEBHOOK_URL=
# OR email via Resend (https://resend.com):
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=info@uaequick.com

# Search Console / verification (optional)
# Paste ONLY the token from the GSC "HTML tag" method (the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Analytics (public) ---
# GA4 Measurement ID (looks like G-XXXXXXXXXX). Defaults to the current property
# if unset. Set this to switch GA4 accounts without a code change.
NEXT_PUBLIC_GA_ID=
# Google Tag Manager container ID (GTM-XXXXXXX). If set, GTM loads INSTEAD of the
# direct GA4 tag (configure GA4 inside GTM). Leave blank to use GA4 directly.
NEXT_PUBLIC_GTM_ID=
